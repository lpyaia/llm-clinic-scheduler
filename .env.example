DATABASE_URL=postgres://clinic:clinic@localhost:5432/clinic?sslmode=disable
TEST_DATABASE_URL=postgres://clinic:clinic@localhost:5433/clinic_test?sslmode=disable
HTTP_ADDR=127.0.0.1:3000
CLINIC_TIMEZONE=America/Sao_Paulo
# Canal oficial da equipe (telefone, WhatsApp, e-mail ou URL). Vazio não inventa um contato.
CLINIC_CONTACT=
HTTP_REQUEST_TIMEOUT=10s
COMMAND_TIMEOUT=2m
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
# Arquivo JSONL local; vazio desativa traces. Crie o diretório antes de iniciar.
CLINIC_TRACE_FILE=
# true captura conteúdo somente em desenvolvimento com pacientes e dados simulados.
CLINIC_TRACE_SYNTHETIC=false
# Tabela JSON de preços por fornecedor/modelo. Vazio deixa o custo indisponível.
CLINIC_MODEL_PRICES_FILE=
